# Copy this file to .env and fill in your own values.

# Any long random string. Used to sign the login session cookie.
SECRET_KEY=replace-with-a-long-random-string

# MySQL connection details (XAMPP defaults shown)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=digital_seettu

# A payment is "due soon" if it falls within this many days
REMINDER_DAYS=3

# Optional: enable email reminders for send_reminders.py --email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
